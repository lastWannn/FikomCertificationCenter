APP_NAME="FIKOM Certification Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fcc_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ──────────────────────────────────────────────────────────────────
# HASHIDS — Penyembunyian ID di URL
# ──────────────────────────────────────────────────────────────────
# HASHID_SALT diambil otomatis dari APP_KEY jika tidak diset.
# HASHID_SALT=

# Panjang minimum hash (default: 8 karakter)
HASHID_MIN_LENGTH=8

# Alfabet kustom — tanpa karakter ambigu (0,1,I,l,O)
HASHID_ALPHABET=abcdefghjkmnpqrstuvwxyz23456789

# ──────────────────────────────────────────────────────────────────
# EMAIL
# ──────────────────────────────────────────────────────────────────
# Opsi 1: Mailtrap (development)
MAIL_MAILER=log
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@fcc.umi.ac.id"
MAIL_FROM_NAME="FCC UMI"

# Opsi 2: Gmail
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=email@gmail.com
# MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
# MAIL_ENCRYPTION=tls

# Opsi 3: Log only (tanpa kirim email)
# MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
